{
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Python: Flask",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "env": {
                "FLASK_APP": "src.api.api:create_api",
                "FLASK_DEBUG": "1",
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "args": [  
                "run",
                "--no-debugger"
            ],
            "jinja":true,
            "justMyCode": true
        }
    ]
}